{
    // Šablona se překládá XeLaTeXem přes latexmk (výstup vedle zdrojového souboru).
    // Kapitoly mají v prvním řádku "% !TEX root = ../mprace.tex", takže Ctrl+Alt+B
    // přeloží celou práci i z otevřené kapitoly.
    "latex-workshop.latex.recipe.default": "latexmk (xelatex)",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (xelatex)",
            "tools": ["xelatexmk"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-xelatex",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-cd",
                "%DOC%"
            ]
        }
    ]
}
